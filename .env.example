# LANDSAFE Environment Configuration Template
# Copy this file to .env and populate with your credentials. Never commit .env to version control.

# Execution Mode: production | demo
LANDSAFE_MODE=production

# Database & Cache
DATABASE_URL=postgresql+asyncpg://landsafe:landsafe_password@localhost:5432/landsafe_db
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage (For Raster & Tile Cache)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=landsafe-rasters

# External Provider Credentials & Keys (Free Tiers)
# NASA FIRMS (Thermal Hotspots) - Register at https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# NASA Earthdata Login (GPM IMERG, GIBS, COOLR) - Register at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Copernicus Data Space Ecosystem (Sentinel-1 SAR / Sentinel-2) - Register at https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=your_cdse_client_id
CDSE_CLIENT_SECRET=your_cdse_client_secret

# MOSDAC / ISRO (INSAT-3D/3DR QPE & IMSRA) - Register at https://www.mosdac.gov.in/
MOSDAC_USERNAME=your_mosdac_user
MOSDAC_PASSWORD=your_mosdac_password

# Bhoonidhi / NRSC (NISAR S-SAR, Resourcesat, Cartosat DEM) - Manual registration via bhoonidhi@nrsc.gov.in
BHOONIDHI_API_KEY=pending_manual_nrsc_approval

# Security & CORS
JWT_SECRET_KEY=generate_a_secure_random_secret_for_production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
